       <string notr="true">background-color: rgb(6, 255, 14);
font: 11pt &quot;Segoe UI&quot;;
color: rgb(0, 0, 0);</string>
      </property>
      <property name="text">
       <string>greet</string>
      </property>
     </widget>
    </item>
   </layout>
  </widget>
